<%- include('../partials/head', { title: 'Restaurants', bodyClass: 'page-app page-admin-restaurants' }) %>
<%- include('../partials/flash') %>
<style>
.resto-admin-wrap { padding: 14px 14px 110px; display: grid; gap: 14px; }
.resto-admin-hero {
  background: linear-gradient(135deg, rgba(255,92,26,0.14), rgba(79,195,247,0.07));
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 18px;
  padding: 16px;
}
.resto-admin-kicker { color: var(--accent2); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
.resto-admin-title { font-size: 22px; font-weight: 900; margin-top: 5px; line-height: 1.1; }
.resto-admin-copy { color: var(--text2); font-size: 13px; line-height: 1.5; margin-top: 8px; }
.resto-panel {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: clip;
}
.resto-panel-head {
  padding: 14px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10px;
}
.resto-panel-title { font-weight: 900; font-size: 16px; }
.resto-panel-sub { color: var(--muted); font-size: 12px; line-height: 1.45; margin-top: 3px; }
.resto-panel-body { padding: 14px; display: grid; gap: 12px; }
.resto-step {
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(255,255,255,0.025);
  padding: 12px;
}
.resto-step-title { display: flex; align-items: center; gap: 8px; font-weight: 900; margin-bottom: 10px; }
.resto-step-num {
  width: 24px; height: 24px; border-radius: 50%;
  background: rgba(255,92,26,0.15);
  color: var(--accent);
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 900;
}
.resto-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 9px; }
.resto-grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 9px; }
.field-help { color: var(--muted); font-size: 11px; line-height: 1.35; margin-top: -2px; }
.preset-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(104px,1fr)); gap: 8px; }
.preset-btn, .small-action {
  min-height: 42px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(255,255,255,0.035);
  color: var(--text);
  font-weight: 800;
  padding: 0 10px;
  text-align: center;
}
.preset-btn:hover, .small-action:hover { border-color: rgba(255,92,26,0.45); color: var(--accent); }
.preset-btn.active { background: rgba(255,92,26,0.16); border-color: rgba(255,92,26,0.45); color: var(--accent); }
.small-action.accent { background: rgba(255,92,26,0.13); border-color: rgba(255,92,26,0.28); color: var(--accent); }
.small-action.danger { color: var(--red); border-color: rgba(255,68,68,0.28); }
.menu-workspace { display: grid; gap: 10px; }
.quick-cat-row, .quick-option-row { display: flex; flex-wrap: wrap; gap: 8px; }
.quick-cat-row .small-action, .quick-option-row .small-action { min-height: 36px; font-size: 12px; }
.menu-summary {
  display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 8px;
}
.summary-pill {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 10px;
  background: var(--surface);
}
.summary-num { font-family: var(--font-d); color: var(--accent); font-size: 28px; line-height: 1; }
.summary-label { color: var(--muted); font-size: 11px; margin-top: 3px; }
.cat-card {
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  padding: 12px;
  display: grid;
  gap: 10px;
}
.cat-title-line { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
.cat-title { font-weight: 900; overflow-wrap: anywhere; }
.cat-head { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: start; }
.cat-fields { display: grid; grid-template-columns: 1fr 150px; gap: 8px; }
.item-card {
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  background: rgba(0,0,0,0.15);
  padding: 10px;
  display: grid;
  gap: 8px;
}
.item-main { display: grid; grid-template-columns: 1fr 105px auto; gap: 8px; align-items: start; }
.item-extra { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.item-title-row { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
.item-title { color: var(--accent2); font-weight: 900; font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; }
.option-card {
  border: 1px dashed rgba(255,255,255,0.18);
  border-radius: 13px;
  padding: 10px;
  display: grid;
  gap: 8px;
}
.option-main { display: grid; grid-template-columns: 1fr 105px auto; gap: 8px; align-items: start; }
.choice-row { display: grid; grid-template-columns: 1fr 90px auto; gap: 8px; align-items: start; }
.builder-empty {
  border: 1px dashed var(--border);
  border-radius: 14px;
  color: var(--muted);
  padding: 14px;
  text-align: center;
  font-size: 13px;
}
.builder-label { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 900; }
.checkline { display: flex; gap: 7px; align-items: center; min-height: 40px; color: var(--text2); font-size: 12px; }
.checkline input { width: 16px; height: 16px; flex-shrink: 0; }
.menu-json-input { display: none; }
.resto-card-admin {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: clip;
}
.resto-row {
  display: grid;
  grid-template-columns: 58px 1fr auto;
  gap: 12px;
  align-items: center;
  padding: 12px;
}
.resto-thumb {
  width: 58px; height: 58px; border-radius: 14px;
  object-fit: cover; background: var(--surface);
  border: 1px solid var(--border);
}
.resto-name { font-weight: 900; overflow-wrap: anywhere; }
.resto-meta { color: var(--muted); font-size: 12px; line-height: 1.45; margin-top: 3px; }
.resto-status {
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 5px 9px;
  font-size: 11px;
  color: var(--muted);
  white-space: nowrap;
}
.resto-status.open { color: var(--green); border-color: rgba(0,230,118,0.35); background: rgba(0,230,118,0.08); }
.resto-status.closed { color: var(--red); border-color: rgba(255,68,68,0.35); background: rgba(255,68,68,0.08); }
.resto-edit { padding: 0 12px 12px; }
.resto-edit summary { list-style: none; }
.resto-edit summary::-webkit-details-marker { display: none; }
.delete-form { margin-top: 10px; }
.sticky-save {
  position: sticky;
  bottom: calc(76px + env(safe-area-inset-bottom));
  z-index: 20;
  background: rgba(9,9,16,0.86);
  padding-top: 8px;
  backdrop-filter: blur(12px);
}
@media (max-width: 520px) {
  .resto-admin-wrap { padding: 10px 10px 105px; }
  .resto-panel-head { flex-direction: column; }
  .resto-grid, .resto-grid-3, .menu-summary, .cat-fields, .item-main, .item-extra, .option-main, .choice-row { grid-template-columns: 1fr; }
  .cat-head { grid-template-columns: 1fr; }
  .small-action, .preset-btn { width: 100%; }
  .quick-cat-row .small-action, .quick-option-row .small-action { width: auto; flex: 1 1 135px; }
  .resto-row { grid-template-columns: 48px 1fr; align-items: start; }
  .resto-thumb { width: 48px; height: 48px; }
  .resto-status { grid-column: 2; justify-self: start; }
}
</style>

<div class="app-layout">
  <header class="top-bar">
    <a href="/admin/dashboard" class="back-btn">Retour admin</a>
    <h1 class="page-title">Restaurants</h1>
  </header>

  <main class="resto-admin-wrap">
    <section class="resto-admin-hero">
      <div class="resto-admin-kicker">Gestion rapide</div>
      <div class="resto-admin-title">Ajoute un restaurant complet sans toucher au code</div>
      <div class="resto-admin-copy">Remplis les infos, charge un modele de carte, modifie les noms/prix/options, puis enregistre. Les clients verront directement le restaurant dans l'app.</div>
    </section>

    <section class="resto-panel">
      <div class="resto-panel-head">
        <div>
          <div class="resto-panel-title">Nouveau restaurant</div>
          <div class="resto-panel-sub">Le plus rapide: choisis un modele, remplace les articles par ceux du restaurant, et publie.</div>
        </div>
      </div>
      <form action="/admin/restaurants" method="POST" class="restaurant-form resto-panel-body">
        <%- include('restaurant-form-fields', { restaurant: null }) %>
        <div class="resto-step">
          <div class="resto-step-title"><span class="resto-step-num">2</span> Carte du restaurant</div>
          <div class="preset-row">
            <button class="preset-btn" type="button" data-preset="tacos" onclick="return window.applyRestaurantPreset(this,event)">Tacos</button>
            <button class="preset-btn" type="button" data-preset="burger" onclick="return window.applyRestaurantPreset(this,event)">Burger</button>
            <button class="preset-btn" type="button" data-preset="sandwich" onclick="return window.applyRestaurantPreset(this,event)">Sandwich</button>
            <button class="preset-btn" type="button" data-preset="pizza" onclick="return window.applyRestaurantPreset(this,event)">Pizza</button>
            <button class="preset-btn" type="button" data-preset="fastfood" onclick="return window.applyRestaurantPreset(this,event)">Complet</button>
          </div>
          <div class="field-help">Choisis une categorie, ajoute chaque type comme un article separe, puis ajoute les options utiles: sauces, gratinage, taille ou supplements.</div>
          <div class="menu-builder" data-menu-builder data-default-preset="fastfood">
            <div class="builder-empty">Chargement de la carte...</div>
          </div>
          <textarea class="menu-json-input" name="menu_json" required>{}</textarea>
        </div>
        <div class="sticky-save">
          <button type="submit" class="btn-primary btn-full btn-lg">Enregistrer le restaurant</button>
        </div>
      </form>
    </section>

    <section class="resto-panel">
      <div class="resto-panel-head">
        <div>
          <div class="resto-panel-title">Restaurants existants (<%= restaurants.length %>)</div>
          <div class="resto-panel-sub">Ouvre un restaurant pour modifier ses infos ou sa carte.</div>
        </div>
      </div>
      <div class="resto-panel-body">
        <% if (restaurants.length === 0) { %>
          <div class="builder-empty">Aucun restaurant pour le moment.</div>
        <% } %>
        <% restaurants.forEach((restaurant) => { %>
          <article class="resto-card-admin">
            <div class="resto-row">
              <img class="resto-thumb" src="<%= restaurant.image || restaurant.coverImage || '/images/icons/icon-192.png' %>" alt="<%= restaurant.name %>" loading="lazy">
              <div>
                <div class="resto-name"><%= restaurant.name %></div>
                <div class="resto-meta"><%= restaurant.category || 'Sans categorie' %>  <%= restaurant.deliveryFee %> DA livraison  min <%= restaurant.minOrder %> DA<br>ID: <%= restaurant.id %></div>
              </div>
              <span class="resto-status <%= restaurant.open ? 'open' : 'closed' %>"><%= restaurant.open ? 'Ouvert' : 'Ferme' %></span>
            </div>
            <details class="resto-edit">
              <summary class="btn-outline btn-full">Modifier</summary>
              <form action="/admin/restaurants/<%= restaurant.id %>/modifier" method="POST" class="restaurant-form" style="margin-top:12px;display:grid;gap:12px">
                <%- include('restaurant-form-fields', { restaurant }) %>
                <div class="resto-step">
                  <div class="resto-step-title"><span class="resto-step-num">2</span> Carte du restaurant</div>
                  <div class="preset-row">
                    <button class="preset-btn" type="button" data-preset="tacos" onclick="return window.applyRestaurantPreset(this,event)">Tacos</button>
                    <button class="preset-btn" type="button" data-preset="burger" onclick="return window.applyRestaurantPreset(this,event)">Burger</button>
                    <button class="preset-btn" type="button" data-preset="sandwich" onclick="return window.applyRestaurantPreset(this,event)">Sandwich</button>
                    <button class="preset-btn" type="button" data-preset="pizza" onclick="return window.applyRestaurantPreset(this,event)">Pizza</button>
                    <button class="preset-btn" type="button" data-preset="fastfood" onclick="return window.applyRestaurantPreset(this,event)">Complet</button>
                  </div>
                  <div class="menu-builder" data-menu-builder>
                    <div class="builder-empty">Chargement de la carte...</div>
                  </div>
                  <textarea class="menu-json-input" name="menu_json" required><%= formatMenuJson(restaurant.menu) %></textarea>
                </div>
                <button type="submit" class="btn-primary btn-full">Enregistrer les modifications</button>
              </form>
              <form action="/admin/restaurants/<%= restaurant.id %>/supprimer" method="POST" class="delete-form">
                <button type="submit" class="btn-danger-sm" onclick="return confirm('Supprimer <%= restaurant.name %> ?')">Supprimer ce restaurant</button>
              </form>
            </details>
          </article>
        <% }) %>
      </div>
    </section>
  </main>

  <%- include('nav', { active: 'restaurants' }) %>
</div>

<script src="/js/admin-restaurant-builder.js?v=1"></script>
<script>
(function() {
  if (window.__adminRestaurantBuilderReady) return;
  const builders = new WeakMap();
  const CATEGORY_TEMPLATES = {
    tacos: {
      label: 'Tacos',
      examples: ['Tacos Poulet', 'Tacos Viande', 'Tacos Mixte'],
      item: 'Tacos Poulet',
      options: ['sauce', 'gratinage', 'supplement']
    },
    burger: {
      label: 'Burger',
      examples: ['Burger Classic', 'Chicken Burger', 'Double Burger'],
      item: 'Burger Classic',
      options: ['sauce', 'supplement']
    },
    sandwich: {
      label: 'Sandwich',
      examples: ['Sandwich Poulet', 'Sandwich Escalope', 'Sandwich Mixte'],
      item: 'Sandwich Poulet',
      options: ['sauce', 'supplement']
    },
    pizza: {
      label: 'Pizza',
      examples: ['Pizza Margherita', 'Pizza Thon', 'Pizza 4 Fromages'],
      item: 'Pizza Margherita',
      options: ['taille', 'supplement']
    },
    boissons: {
      label: 'Boissons',
      examples: ['Coca 33cl', 'Fanta 33cl', 'Eau'],
      item: 'Boisson 33cl',
      options: ['boisson']
    }
  };

  const PRESETS = {
    fastfood: {
      tacos: category('Tacos', [
        product('Tacos Poulet', 450, 'Poulet, frites, sauce au choix', ['sauce', 'gratinage', 'supplement']),
        product('Tacos Viande', 500, 'Viande hachee, frites, sauce au choix', ['sauce', 'gratinage', 'supplement']),
        product('Tacos Mixte', 600, 'Deux viandes, frites, sauce au choix', ['sauce', 'gratinage', 'supplement'])
      ]),
      burger: category('Burger', [
        product('Burger Classic', 400, 'Steak, fromage, salade, sauce', ['sauce', 'supplement']),
        product('Chicken Burger', 450, 'Poulet pane, fromage, sauce', ['sauce', 'supplement'])
      ]),
      sandwich: category('Sandwich', [
        product('Sandwich Poulet', 350, 'Poulet, frites, sauce', ['sauce', 'supplement']),
        product('Sandwich Escalope', 420, 'Escalope, frites, sauce', ['sauce', 'supplement'])
      ]),
      pizza: category('Pizza', [
        product('Pizza Margherita', 550, 'Tomate, fromage', ['taille', 'supplement']),
        product('Pizza Thon', 700, 'Tomate, fromage, thon', ['taille', 'supplement'])
      ]),
      boissons: category('Boissons', [
        product('Boisson 33cl', 120, 'Boisson au choix', ['boisson']),
        product('Eau', 80, 'Bouteille eau', [])
      ])
    },
    pizza: {
      pizza: category('Pizza', [
        product('Pizza Margherita', 550, 'Tomate, fromage', ['taille', 'supplement']),
        product('Pizza Reine', 700, 'Tomate, fromage, champignons', ['taille', 'supplement']),
        product('Pizza Thon', 700, 'Tomate, fromage, thon', ['taille', 'supplement']),
        product('Pizza 4 Fromages', 800, 'Fromages melanges', ['taille', 'supplement'])
      ])
    },
    tacos: {
      tacos: category('Tacos', [
        product('Tacos Poulet', 450, 'Poulet, frites, sauce au choix', ['sauce', 'gratinage', 'supplement']),
        product('Tacos Viande', 500, 'Viande hachee, frites, sauce au choix', ['sauce', 'gratinage', 'supplement']),
        product('Tacos Mixte', 600, 'Poulet et viande, frites, sauce au choix', ['sauce', 'gratinage', 'supplement']),
        product('Tacos Crispy', 550, 'Poulet crispy, frites, sauce au choix', ['sauce', 'gratinage', 'supplement'])
      ])
    },
    burger: {
      burger: category('Burger', [
        product('Burger Classic', 400, 'Steak, fromage, salade, sauce', ['sauce', 'supplement']),
        product('Chicken Burger', 450, 'Poulet pane, fromage, sauce', ['sauce', 'supplement']),
        product('Double Burger', 600, 'Double steak, fromage, sauce', ['sauce', 'supplement'])
      ])
    },
    sandwich: {
      sandwich: category('Sandwich', [
        product('Sandwich Poulet', 350, 'Poulet, frites, sauce', ['sauce', 'supplement']),
        product('Sandwich Viande', 400, 'Viande, frites, sauce', ['sauce', 'supplement']),
        product('Sandwich Mixte', 500, 'Deux viandes, frites, sauce', ['sauce', 'supplement'])
      ])
    }
  };

  const OPTION_TEMPLATES = {
    sauce: () => choiceOption('sauce', 'Sauce', false, [['algerienne','Algerienne',0], ['blanche','Blanche',0], ['harissa','Harissa',0], ['bbq','BBQ',0], ['mayonnaise','Mayonnaise',0]]),
    gratinage: () => checkOption('gratinage', 'Gratinage fromage', 80),
    taille: () => choiceOption('taille', 'Taille', true, [['moyenne','Moyenne',0], ['grande','Grande',150], ['xl','XL',300]]),
    supplement: () => choiceOption('supplement', 'Supplement', false, [['fromage','Fromage',80], ['oeuf','Oeuf',80], ['frites','Frites',100], ['viande-extra','Viande extra',180]]),
    boisson: () => choiceOption('boisson', 'Boisson', true, [['coca','Coca',0], ['fanta','Fanta',0], ['hamoud','Hamoud',0], ['eau','Eau',0]]),
    libre: () => choiceOption('option', 'Option libre', false, [['standard','Standard',0]])
  };

  function category(label, items) {
    return { label, items };
  }
  function product(name, price, description, optionKeys) {
    return item(slugify(name), name, price, description, '', optionKeys.map((key) => OPTION_TEMPLATES[key]()));
  }
  function item(id, name, price, description, image, options) {
    const optionObject = {};
    options.forEach((opt) => { optionObject[opt.key] = opt.value; });
    return { id, name, basePrice: price, description, image, options: optionObject };
  }
  function choiceOption(key, label, required, choices) {
    return { key, value: { label, required, choices: choices.map((row) => ({ id: row[0], label: row[1], price: row[2] })) } };
  }
  function checkOption(key, label, price) {
    return { key, value: { label, required: false, type: 'checkbox', price } };
  }
  function slugify(value) {
    return String(value || 'item').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60) || 'item';
  }
  function esc(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char]);
  }
  function menuToState(menu) {
    return Object.entries(menu || {}).map(([key, cat]) => ({
      key: slugify(key),
      label: String((cat && cat.label) || key || 'Categorie'),
      items: Array.isArray(cat && cat.items) ? cat.items.map(itemToState) : [],
    }));
  }
  function itemToState(raw) {
    raw = raw || {};
    return {
      id: String(raw.id || slugify(raw.name || 'article')),
      name: String(raw.name || ''),
      basePrice: Number(raw.basePrice || 0),
      description: String(raw.description || ''),
      image: String(raw.image || ''),
      options: Object.entries(raw.options || {}).map(([key, opt]) => ({
        key: slugify(key),
        label: String((opt && opt.label) || key),
        type: opt && opt.type === 'checkbox' ? 'checkbox' : 'choices',
        required: Boolean(opt && opt.required),
        price: Number((opt && opt.price) || 0),
        choices: Array.isArray(opt && opt.choices) ? opt.choices.map((choice) => ({ id: String(choice.id || slugify(choice.label)), label: String(choice.label || ''), price: Number(choice.price || 0) })) : [],
      })),
    };
  }
  function stateToMenu(state) {
    const menu = {};
    state.categories.forEach((cat, catIndex) => {
      const catKey = slugify(cat.key || cat.label || 'categorie-' + (catIndex + 1));
      menu[catKey] = { label: cat.label || catKey, items: cat.items.map((row, itemIndex) => {
        const options = {};
        row.options.forEach((opt, optIndex) => {
          const key = slugify(opt.key || opt.label || 'option-' + (optIndex + 1));
          options[key] = opt.type === 'checkbox'
            ? { label: opt.label || key, required: Boolean(opt.required), type: 'checkbox', price: Number(opt.price || 0) }
            : { label: opt.label || key, required: Boolean(opt.required), choices: opt.choices.map((choice, choiceIndex) => ({ id: slugify(choice.id || choice.label || 'choix-' + (choiceIndex + 1)), label: choice.label || 'Choix', price: Number(choice.price || 0) })) };
        });
        return { id: slugify(row.id || row.name || 'article-' + (itemIndex + 1)), name: row.name || 'Article', basePrice: Number(row.basePrice || 0), description: row.description || '', image: row.image || '', options };
      }) };
    });
    return menu;
  }
  function sync(builder) {
    const state = builders.get(builder);
    state.textarea.value = JSON.stringify(stateToMenu(state), null, 2);
  }
  function stats(state) {
    const categories = state.categories.length;
    const items = state.categories.reduce((sum, cat) => sum + cat.items.length, 0);
    const options = state.categories.reduce((sum, cat) => sum + cat.items.reduce((n, item) => n + item.options.length, 0), 0);
    return { categories, items, options };
  }
  function render(builder) {
    const state = builders.get(builder);
    const s = stats(state);
    builder.innerHTML = [
      '<div class="menu-workspace">',
      '<div class="menu-summary">',
      summary(s.categories, 'Categories'),
      summary(s.items, 'Articles'),
      summary(s.options, 'Options'),
      '</div>',
      '<div style="display:flex;gap:8px;flex-wrap:wrap">',
      '<button class="small-action accent" type="button" data-action="add-cat" onclick="return window.applyRestaurantBuilderAction(this,event)">+ Ajouter une categorie</button>',
      '</div>',
      '<div class="quick-cat-row">',
      quickCat('tacos'), quickCat('burger'), quickCat('sandwich'), quickCat('pizza'), quickCat('boissons'),
      '</div>',
      state.categories.length ? state.categories.map(renderCategory).join('') : '<div class="builder-empty">Aucune categorie. Clique sur un modele ou ajoute une categorie.</div>',
      '</div>'
    ].join('');
    sync(builder);
  }
  function quickCat(type) {
    return '<button class="small-action" type="button" data-action="add-template-cat" data-template="' + type + '" onclick="return window.applyRestaurantBuilderAction(this,event)">+ ' + esc(CATEGORY_TEMPLATES[type].label) + '</button>';
  }
  function summary(num, label) {
    return '<div class="summary-pill"><div class="summary-num">' + num + '</div><div class="summary-label">' + label + '</div></div>';
  }
  function renderCategory(cat, catIndex) {
    return '<section class="cat-card" data-cat="' + catIndex + '">' +
      '<div class="cat-title-line"><div><div class="cat-title">' + esc(cat.label || 'Categorie') + '</div><div class="field-help">Ajoute chaque type en article separe: Poulet, Viande, Mixte...</div></div></div>' +
      '<div class="cat-head"><div class="cat-fields">' +
      input('Nom categorie', cat.label, { field: 'label', cat: catIndex }) +
      input('Cle', cat.key, { field: 'key', cat: catIndex }) +
      '</div><button class="small-action danger" type="button" data-action="remove-cat" data-cat="' + catIndex + '" onclick="return window.applyRestaurantBuilderAction(this,event)">Supprimer</button></div>' +
      '<div class="builder-label">Types / articles</div>' +
      (cat.items.length ? cat.items.map((row, itemIndex) => renderItem(row, catIndex, itemIndex)).join('') : '<div class="builder-empty">Aucun article ici.</div>') +
      '<button class="small-action accent" type="button" data-action="add-item" data-cat="' + catIndex + '" onclick="return window.applyRestaurantBuilderAction(this,event)">+ Ajouter un type</button>' +
    '</section>';
  }
  function renderItem(row, catIndex, itemIndex) {
    return '<div class="item-card">' +
      '<div class="item-title-row"><div class="item-title">Type #' + (itemIndex + 1) + '</div><button class="small-action danger" type="button" data-action="remove-item" data-cat="' + catIndex + '" data-item="' + itemIndex + '" onclick="return window.applyRestaurantBuilderAction(this,event)">Suppr.</button></div>' +
      '<div class="item-main">' +
      input('Nom du type: Tacos Poulet', row.name, { field: 'name', cat: catIndex, item: itemIndex }) +
      input('Prix DA', row.basePrice, { field: 'basePrice', cat: catIndex, item: itemIndex, type: 'number' }) +
      '</div>' +
      '<div class="item-extra">' + input('Description courte', row.description, { field: 'description', cat: catIndex, item: itemIndex }) + input('ID automatique', row.id, { field: 'id', cat: catIndex, item: itemIndex }) + '</div>' +
      input('Image URL optionnelle', row.image, { field: 'image', cat: catIndex, item: itemIndex, type: 'url' }) +
      '<div class="builder-label">Options quand le client choisit cet article</div>' +
      '<div class="quick-option-row">' +
      quickOption('sauce', 'Sauces', catIndex, itemIndex) +
      quickOption('gratinage', 'Gratinage', catIndex, itemIndex) +
      quickOption('taille', 'Tailles', catIndex, itemIndex) +
      quickOption('supplement', 'Supplements', catIndex, itemIndex) +
      quickOption('libre', 'Option libre', catIndex, itemIndex) +
      '</div>' +
      (row.options.length ? row.options.map((opt, optIndex) => renderOption(opt, catIndex, itemIndex, optIndex)).join('') : '<div class="builder-empty">Pas d option. Exemple: sauce, gratinage, supplement fromage.</div>') +
    '</div>';
  }
  function quickOption(template, label, catIndex, itemIndex) {
    return '<button class="small-action" type="button" data-action="add-option-template" data-template="' + template + '" data-cat="' + catIndex + '" data-item="' + itemIndex + '" onclick="return window.applyRestaurantBuilderAction(this,event)">+ ' + label + '</button>';
  }
  function renderOption(opt, catIndex, itemIndex, optIndex) {
    const choices = opt.type === 'checkbox'
      ? input('Prix supplement', opt.price, { field: 'price', cat: catIndex, item: itemIndex, option: optIndex, type: 'number' })
      : opt.choices.map((choice, choiceIndex) => '<div class="choice-row">' + input('Choix', choice.label, { field: 'label', cat: catIndex, item: itemIndex, option: optIndex, choice: choiceIndex }) + input('Prix +', choice.price, { field: 'price', cat: catIndex, item: itemIndex, option: optIndex, choice: choiceIndex, type: 'number' }) + '<button class="small-action danger" type="button" data-action="remove-choice" data-cat="' + catIndex + '" data-item="' + itemIndex + '" data-option="' + optIndex + '" data-choice="' + choiceIndex + '" onclick="return window.applyRestaurantBuilderAction(this,event)">Suppr.</button></div>').join('');
    return '<div class="option-card">' +
      '<div class="option-main">' +
      input('Nom option', opt.label, { field: 'label', cat: catIndex, item: itemIndex, option: optIndex }) +
      '<label class="checkline"><input type="checkbox" data-field="required" data-cat="' + catIndex + '" data-item="' + itemIndex + '" data-option="' + optIndex + '"' + (opt.required ? ' checked' : '') + '> Requis</label>' +
      '<button class="small-action danger" type="button" data-action="remove-option" data-cat="' + catIndex + '" data-item="' + itemIndex + '" data-option="' + optIndex + '" onclick="return window.applyRestaurantBuilderAction(this,event)">Suppr.</button>' +
      '</div>' +
      '<div class="item-extra">' + input('Cle option', opt.key, { field: 'key', cat: catIndex, item: itemIndex, option: optIndex }) +
      '<select class="field-input" data-field="type" data-cat="' + catIndex + '" data-item="' + itemIndex + '" data-option="' + optIndex + '"><option value="choices"' + (opt.type !== 'checkbox' ? ' selected' : '') + '>Liste de choix</option><option value="checkbox"' + (opt.type === 'checkbox' ? ' selected' : '') + '>Oui / non</option></select></div>' +
      choices +
      (opt.type === 'checkbox' ? '' : '<button class="small-action" type="button" data-action="add-choice" data-cat="' + catIndex + '" data-item="' + itemIndex + '" data-option="' + optIndex + '" onclick="return window.applyRestaurantBuilderAction(this,event)">+ Ajouter choix</button>') +
    '</div>';
  }
  function input(placeholder, value, meta) {
    const attrs = Object.entries(meta).map(([key, val]) => 'data-' + key + '="' + esc(val) + '"').join(' ');
    return '<input class="field-input" type="' + esc(meta.type || 'text') + '" placeholder="' + esc(placeholder) + '" value="' + esc(value) + '" ' + attrs + '>';
  }
  function indexes(el) {
    return { field: el.dataset.field, cat: num(el.dataset.cat), item: num(el.dataset.item), option: num(el.dataset.option), choice: num(el.dataset.choice) };
  }
  function num(value) { return value == null ? null : Number(value); }
  function target(state, ix) {
    let obj = state.categories[ix.cat];
    if (ix.item != null) obj = obj.items[ix.item];
    if (ix.option != null) obj = obj.options[ix.option];
    if (ix.choice != null) obj = obj.choices[ix.choice];
    return obj;
  }
  function onInput(builder, el) {
    const state = builders.get(builder);
    const ix = indexes(el);
    if (!ix.field || ix.cat == null) return;
    const obj = target(state, ix);
    if (!obj) return;
    obj[ix.field] = el.type === 'checkbox' ? el.checked : el.type === 'number' ? Number(el.value || 0) : el.value;
    if (ix.field === 'type') {
      if (obj.type === 'checkbox') obj.choices = [];
      if (obj.type === 'choices' && !obj.choices.length) obj.choices = [{ id: 'standard', label: 'Standard', price: 0 }];
      render(builder);
      return;
    }
    sync(builder);
  }
  function onAction(builder, button) {
    const state = builders.get(builder);
    const action = button.dataset.action;
    const ix = indexes(button);
    if (button.dataset.preset) state.categories = menuToState(PRESETS[button.dataset.preset]);
    if (action === 'add-template-cat') state.categories.push(templateCategory(button.dataset.template, state.categories.map((cat) => cat.key)));
    if (action === 'add-cat') state.categories.push({ key: 'categorie-' + (state.categories.length + 1), label: 'Nouvelle categorie', items: [] });
    if (action === 'remove-cat') state.categories.splice(ix.cat, 1);
    if (action === 'add-item') state.categories[ix.cat].items.push(defaultItemForCategory(state.categories[ix.cat]));
    if (action === 'remove-item') state.categories[ix.cat].items.splice(ix.item, 1);
    if (action === 'add-option-template') addOptionTemplate(state.categories[ix.cat].items[ix.item], button.dataset.template);
    if (action === 'remove-option') state.categories[ix.cat].items[ix.item].options.splice(ix.option, 1);
    if (action === 'add-choice') state.categories[ix.cat].items[ix.item].options[ix.option].choices.push({ id: 'choix-' + (state.categories[ix.cat].items[ix.item].options[ix.option].choices.length + 1), label: 'Nouveau choix', price: 0 });
    if (action === 'remove-choice') state.categories[ix.cat].items[ix.item].options[ix.option].choices.splice(ix.choice, 1);
    render(builder);
  }
  function templateCategory(type, existingKeys) {
    const tpl = CATEGORY_TEMPLATES[type] || CATEGORY_TEMPLATES.tacos;
    return {
      key: uniqueKey(slugify(tpl.label), existingKeys || []),
      label: tpl.label,
      items: tpl.examples.map((name, itemIndex) => ({
        id: slugify(name),
        name,
        basePrice: itemIndex === 0 ? 0 : 0,
        description: '',
        image: '',
        options: tpl.options.map((key) => optionState(OPTION_TEMPLATES[key]()))
      }))
    };
  }
  function defaultItemForCategory(cat) {
    const base = Object.values(CATEGORY_TEMPLATES).find((tpl) => slugify(tpl.label) === slugify(cat.label)) || { item: 'Nouvel article', options: [] };
    const name = base.item || 'Nouvel article';
    const count = cat.items.length + 1;
    return { id: slugify(name + '-' + count), name, basePrice: 0, description: '', image: '', options: (base.options || []).map((key) => optionState(OPTION_TEMPLATES[key]())) };
  }
  function addOptionTemplate(row, template) {
    const factory = OPTION_TEMPLATES[template] || OPTION_TEMPLATES.libre;
    const opt = optionState(factory());
    opt.key = uniqueKey(opt.key, row.options.map((existing) => existing.key));
    row.options.push(opt);
  }
  function optionState(opt) {
    return itemToState({ options: { [opt.key]: opt.value } }).options[0];
  }
  function uniqueKey(base, existing) {
    const clean = slugify(base);
    let key = clean;
    let index = 2;
    while (existing.includes(key)) {
      key = clean + '-' + index;
      index += 1;
    }
    return key;
  }
  function builderFromControl(control) {
    const step = control.closest('.resto-step');
    if (step) {
      const builder = step.querySelector('[data-menu-builder]');
      if (builder && builders.has(builder)) return builder;
    }
    const form = control.closest('.restaurant-form');
    if (!form) return null;
    const builder = form.querySelector('[data-menu-builder]');
    return builder && builders.has(builder) ? builder : null;
  }
  function triggerBuilderAction(button, event) {
    const builder = builderFromControl(button);
    if (!builder) return false;
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    onAction(builder, button);
    return false;
  }
  function triggerPreset(button, event) {
    const builder = builderFromControl(button);
    if (!builder) return false;
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    onAction(builder, button);
    const step = button.closest('.resto-step');
    const rendered = step && step.querySelector('.menu-workspace');
    if (rendered) rendered.scrollIntoView({ behavior: 'smooth', block: 'start' });
    return false;
  }
  window.applyRestaurantBuilderAction = triggerBuilderAction;
  window.applyRestaurantPreset = triggerPreset;
  document.querySelectorAll('.restaurant-form').forEach((form) => {
    const builder = form.querySelector('[data-menu-builder]');
    const textarea = form.querySelector('.menu-json-input');
    if (!builder || !textarea) return;
    let parsed = {};
    try { parsed = JSON.parse(textarea.value || '{}'); } catch { parsed = {}; }
    const existing = menuToState(parsed);
    builders.set(builder, { textarea, categories: existing.length ? existing : menuToState(PRESETS[builder.dataset.defaultPreset || 'fastfood']) });
    render(builder);
    builder.addEventListener('click', (event) => {
      const button = event.target.closest('button');
      if (!button) return;
      if (!button.dataset.action && !button.dataset.preset) return;
      event.preventDefault();
      onAction(builder, button);
    });
    builder.addEventListener('input', (event) => onInput(builder, event.target));
    builder.addEventListener('change', (event) => onInput(builder, event.target));
    form.addEventListener('submit', () => sync(builder));
  });
  document.addEventListener('click', (event) => {
    const presetButton = event.target.closest('[data-preset]');
    if (!presetButton) return;
    triggerPreset(presetButton, event);
  });
})();
</script>
</body></html>
