<%
const disableI18nPage = typeof disableI18n !== 'undefined' && disableI18n;
const pageLang = disableI18nPage ? 'fr' : (typeof lang !== 'undefined' ? lang : 'fr');
const pageDir = disableI18nPage ? 'ltr' : (typeof langDir !== 'undefined' ? langDir : 'ltr');
const pageIsArabic = disableI18nPage ? false : (typeof isArabic !== 'undefined' && isArabic);
%>
<!DOCTYPE html>
<html lang="<%= pageLang %>" dir="<%= pageDir %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#090910">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Koloo Go">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Koloo Go</title>
<script>
(function () {
  try {
    if (sessionStorage.getItem('kolo_go_start_splash_seen') === '1') {
      document.documentElement.classList.add('app-splash-seen');
    }
  } catch (_) {}
})();
</script>
<style>
html,
body {
  background: #090910;
}
.app-splash {
  position: fixed;
  inset: 0;
  z-index: 2147483000;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 14px;
  background:
    radial-gradient(circle at 50% 38%, rgba(255,92,26,0.18), transparent 34%),
    #090910;
  color: #fff;
  opacity: 1;
  visibility: visible;
  transition: opacity 0.18s ease, visibility 0.18s ease;
  pointer-events: none;
}
html.app-splash-seen .app-splash {
  display: none;
}
.app-splash.is-hidden {
  opacity: 0;
  visibility: hidden;
}
.app-splash-logo {
  width: 92px;
  height: 92px;
  border-radius: 24px;
  box-shadow: 0 18px 48px rgba(255,92,26,0.22);
}
.app-splash-title {
  font: 800 22px/1 system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  letter-spacing: 0;
}
.app-splash-loader {
  width: 64px;
  height: 3px;
  border-radius: 999px;
  overflow: hidden;
  background: rgba(255,255,255,0.12);
}
.app-splash-loader::after {
  content: '';
  display: block;
  width: 40%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff5c1a, #ffb347);
  animation: appSplashLoad 0.85s ease-in-out infinite;
}
@keyframes appSplashLoad {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(260%); }
}
</style>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" type="image/png" sizes="192x192" href="/images/icons/icon-192.png">
<link rel="apple-touch-icon" href="/images/icons/icon-192.png">
<link rel="preload" as="image" href="/images/icons/icon-192.png">
<link rel="apple-touch-startup-image" href="/images/splash/apple-splash-1170x2532.png" media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
<link rel="apple-touch-startup-image" href="/images/splash/apple-splash-1125x2436.png" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
<link rel="apple-touch-startup-image" href="/images/splash/apple-splash-1242x2688.png" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
<link rel="apple-touch-startup-image" href="/images/splash/apple-splash-1284x2778.png" media="(device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
<link rel="apple-touch-startup-image" href="/images/splash/apple-splash-1290x2796.png" media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
<link rel="apple-touch-startup-image" href="/images/splash/apple-splash-1179x2556.png" media="(device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
<link rel="apple-touch-startup-image" href="/images/splash/apple-splash-1080x1920.png" media="(device-width: 360px) and (device-height: 640px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="dns-prefetch" href="https://unpkg.com">
<link rel="dns-prefetch" href="https://upload.wikimedia.org">
<link rel="dns-prefetch" href="https://tile.openstreetmap.org">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css?v=fluid-5">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %> <%= pageIsArabic ? 'lang-ar' : 'lang-fr' %>">
<div class="app-splash" id="app-splash" aria-hidden="true">
  <img class="app-splash-logo" src="/images/icons/icon-192.png" width="92" height="92" alt="">
  <div class="app-splash-title">Koloo Go</div>
  <div class="app-splash-loader"></div>
</div>
<% if (!disableI18nPage) { %>
  <a class="lang-switch" href="/lang/<%= typeof langSwitchTarget !== 'undefined' ? langSwitchTarget : 'ar' %>" aria-label="Changer la langue">
    <%= typeof langSwitchLabel !== 'undefined' ? langSwitchLabel : 'AR' %>
  </a>
<% } %>
<script>
window.COLLO_LANG = <%- JSON.stringify(pageLang) %>;
</script>
<% if (!disableI18nPage) { %>
  <script defer src="/js/i18n.js?v=ar-3"></script>
<% } %>
<script defer src="/js/pwa.js?v=5"></script>
<script defer src="/js/push.js?v=pwa-push-1"></script>
<script defer src="/js/app-fast.js?v=fluid-5"></script>
