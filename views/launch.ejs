<%- include('partials/head', { title, bodyClass: 'page-launch', disableI18n: true }) %>
<%
const pollVotes = typeof launchVotes !== 'undefined' && launchVotes ? launchVotes : {};
const likesCount = Number(typeof launchLikes !== 'undefined' ? launchLikes : 0);
function voteCount(key) {
  return Number(pollVotes[key] || 0);
}
%>

<main class="launch-page">
  <section class="launch-hero">
    <div class="launch-orbit launch-orbit-one"></div>
    <div class="launch-orbit launch-orbit-two"></div>

    <div class="launch-badge">Koloo Go arrive a Collo</div>
    <h1>Ouverture dimanche 19 juillet a 11h</h1>
    <p class="launch-subtitle">
      Livraison rapide de restaurants, snacks et commandes locales. On prepare les derniers details avant le depart.
    </p>

    <div class="launch-countdown" data-launch-at="<%= launchAtIso %>">
      <div class="launch-timebox">
        <strong data-count-days>00</strong>
        <span>jours</span>
      </div>
      <div class="launch-timebox">
        <strong data-count-hours>00</strong>
        <span>heures</span>
      </div>
      <div class="launch-timebox">
        <strong data-count-minutes>00</strong>
        <span>minutes</span>
      </div>
      <div class="launch-timebox">
        <strong data-count-seconds>00</strong>
        <span>secondes</span>
      </div>
    </div>

    <div class="launch-actions">
      <button class="launch-like" type="button" data-like-button>
        <span>Je soutiens le projet</span>
        <strong><span data-like-count><%= likesCount %></span> likes</strong>
      </button>
      <div class="launch-mini">
        <span>Collo</span>
        <span>Cash a la livraison</span>
        <span>Ouverture 11h</span>
      </div>
    </div>

    <div class="launch-poll" data-launch-poll>
      <div class="launch-poll-title">Vous preferez quoi pour le lancement ?</div>
      <div class="launch-poll-grid">
        <button type="button" data-poll-choice="tacos"><span>Tacos</span><strong data-poll-count="tacos"><%= voteCount('tacos') %></strong></button>
        <button type="button" data-poll-choice="pizza"><span>Pizza</span><strong data-poll-count="pizza"><%= voteCount('pizza') %></strong></button>
        <button type="button" data-poll-choice="burger"><span>Burger</span><strong data-poll-count="burger"><%= voteCount('burger') %></strong></button>
        <button type="button" data-poll-choice="sandwich"><span>Sandwich</span><strong data-poll-count="sandwich"><%= voteCount('sandwich') %></strong></button>
        <button type="button" data-poll-choice="poutine"><span>Poutine</span><strong data-poll-count="poutine"><%= voteCount('poutine') %></strong></button>
        <button type="button" data-poll-choice="chawarma"><span>Chawarma</span><strong data-poll-count="chawarma"><%= voteCount('chawarma') %></strong></button>
      </div>
    </div>
  </section>

  <section class="launch-preview" aria-label="Apercu">
    <div class="launch-phone">
      <div class="launch-phone-top"></div>
      <div class="launch-card launch-card-hot">
        <span>Fast-food</span>
        <strong>Tacos, pizzas, burgers</strong>
      </div>
      <div class="launch-card">
        <span>Livraison</span>
        <strong>Suivi simple et rapide</strong>
      </div>
      <div class="launch-card">
        <span>Paiement</span>
        <strong>Cash a la reception</strong>
      </div>
    </div>
  </section>

  <form class="launch-dev-access" action="/launch-access" method="post" autocomplete="off">
    <button class="launch-dev-toggle" type="button" data-dev-toggle>acces</button>
    <div class="launch-dev-fields" data-dev-fields>
      <% if (accessError && accessError.length) { %>
        <div class="launch-error"><%= accessError[0] %></div>
      <% } %>
      <input type="password" name="password" placeholder="mot de passe" aria-label="Mot de passe">
      <button type="submit">Entrer</button>
    </div>
  </form>
</main>

<style>
.page-launch {
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 129, 42, 0.22), transparent 34%),
    linear-gradient(180deg, #07070d 0%, #10101a 54%, #07070d 100%);
}
.page-launch .app-splash,
.page-launch .lang-switch {
  display: none;
}
.launch-page {
  min-height: 100vh;
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.72fr);
  align-items: center;
  gap: 36px;
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
  padding: 48px 0 76px;
  color: #fff;
  position: relative;
}
.launch-hero {
  position: relative;
  isolation: isolate;
}
.launch-orbit {
  position: absolute;
  border-radius: 999px;
  filter: blur(2px);
  pointer-events: none;
  z-index: -1;
}
.launch-orbit-one {
  width: 260px;
  height: 260px;
  top: -90px;
  left: -80px;
  border: 1px solid rgba(255, 135, 51, 0.32);
  box-shadow: 0 0 70px rgba(255, 92, 26, 0.18);
}
.launch-orbit-two {
  width: 130px;
  height: 130px;
  right: 16%;
  bottom: -18px;
  background: radial-gradient(circle, rgba(255, 92, 26, 0.22), transparent 64%);
}
.launch-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 14px;
  border: 1px solid rgba(255, 129, 42, 0.42);
  border-radius: 999px;
  background: rgba(255, 92, 26, 0.1);
  color: #ffb27a;
  font: 700 12px/1 var(--font-m);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.launch-badge::before {
  content: '';
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ff5c1a;
  box-shadow: 0 0 16px rgba(255, 92, 26, 0.9);
}
.launch-hero h1 {
  margin: 24px 0 14px;
  max-width: 760px;
  font-family: var(--font-d);
  font-size: clamp(58px, 9vw, 118px);
  line-height: 0.86;
  letter-spacing: 0;
  text-transform: uppercase;
}
.launch-subtitle {
  max-width: 560px;
  color: rgba(255,255,255,0.72);
  font-size: 18px;
  line-height: 1.6;
}
.launch-countdown {
  display: grid;
  grid-template-columns: repeat(4, minmax(92px, 1fr));
  gap: 12px;
  max-width: 620px;
  margin: 32px 0 22px;
}
.launch-timebox {
  min-height: 104px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.055);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 18px 44px rgba(0,0,0,0.24);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 16px;
}
.launch-timebox strong {
  font-family: var(--font-m);
  font-size: clamp(30px, 5vw, 48px);
  color: #ff7a2f;
}
.launch-timebox span {
  margin-top: 6px;
  color: rgba(255,255,255,0.62);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.launch-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  align-items: center;
}
.launch-like {
  border: 0;
  min-height: 58px;
  border-radius: 18px;
  padding: 10px 18px;
  background: linear-gradient(135deg, #ff5c1a, #ffb347);
  color: white;
  box-shadow: 0 20px 42px rgba(255, 92, 26, 0.24);
  font: 800 14px/1.1 var(--font-b);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 5px;
  transition: transform 0.14s ease, filter 0.14s ease;
}
.launch-like:hover {
  transform: translateY(-1px);
  filter: brightness(1.04);
}
.launch-like.is-liked {
  background: linear-gradient(135deg, #00c878, #36df9b);
}
.launch-like strong {
  font-family: var(--font-m);
  font-size: 13px;
}
.launch-mini {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.launch-mini span {
  padding: 10px 12px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.11);
  background: rgba(255,255,255,0.045);
  color: rgba(255,255,255,0.72);
  font-size: 12px;
}
.launch-poll {
  max-width: 620px;
  margin-top: 22px;
  padding: 16px;
  border-radius: 22px;
  border: 1px solid rgba(255,255,255,0.11);
  background: rgba(255,255,255,0.045);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
}
.launch-poll-title {
  margin-bottom: 12px;
  color: rgba(255,255,255,0.78);
  font-weight: 800;
  font-size: 14px;
}
.launch-poll-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}
.launch-poll-grid button {
  min-height: 54px;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 16px;
  background: rgba(11, 12, 22, 0.72);
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  transition: transform 0.14s ease, border-color 0.14s ease, background-color 0.14s ease;
}
.launch-poll-grid button:hover,
.launch-poll-grid button.is-picked {
  transform: translateY(-1px);
  border-color: rgba(255, 129, 42, 0.56);
  background: rgba(255, 92, 26, 0.14);
}
.launch-poll-grid span {
  font-weight: 800;
  font-size: 13px;
}
.launch-poll-grid strong {
  font-family: var(--font-m);
  color: #ff9b57;
  font-size: 14px;
}
.launch-preview {
  display: flex;
  justify-content: center;
}
.launch-phone {
  width: min(330px, 100%);
  min-height: 520px;
  border-radius: 38px;
  padding: 24px;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0.025)),
    #11131f;
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 34px 90px rgba(0,0,0,0.42);
  position: relative;
  overflow: hidden;
}
.launch-phone::before {
  content: '';
  position: absolute;
  inset: -90px -70px auto auto;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: rgba(255, 92, 26, 0.18);
  filter: blur(6px);
}
.launch-phone-top {
  width: 112px;
  height: 8px;
  border-radius: 999px;
  margin: 4px auto 42px;
  background: rgba(255,255,255,0.16);
}
.launch-card {
  position: relative;
  padding: 18px;
  border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.055);
  margin-bottom: 14px;
}
.launch-card-hot {
  background: linear-gradient(135deg, rgba(255, 92, 26, 0.32), rgba(255,255,255,0.06));
  border-color: rgba(255, 129, 42, 0.36);
}
.launch-card span {
  color: rgba(255,255,255,0.6);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.launch-card strong {
  display: block;
  margin-top: 8px;
  font-size: 22px;
  line-height: 1.16;
}
.launch-dev-access {
  position: fixed;
  left: 16px;
  bottom: 10px;
  z-index: 20;
  opacity: 0.35;
  transition: opacity 0.15s ease;
}
.launch-dev-access:hover,
.launch-dev-access.is-open {
  opacity: 1;
}
.launch-dev-toggle {
  border: 0;
  background: transparent;
  color: rgba(255,255,255,0.38);
  font-size: 10px;
  cursor: pointer;
}
.launch-dev-fields {
  display: none;
  gap: 6px;
  margin-top: 7px;
  padding: 8px;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 14px;
  background: rgba(10,10,18,0.92);
}
.launch-dev-access.is-open .launch-dev-fields {
  display: flex;
}
.launch-dev-fields input {
  width: 128px;
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 10px;
  background: rgba(255,255,255,0.06);
  color: white;
  padding: 8px;
}
.launch-dev-fields button {
  border: 0;
  border-radius: 10px;
  background: #ff5c1a;
  color: white;
  font-weight: 800;
  padding: 8px 10px;
  cursor: pointer;
}
.launch-error {
  position: absolute;
  bottom: 52px;
  left: 8px;
  color: #ffb2a1;
  font-size: 11px;
  white-space: nowrap;
}
@media (max-width: 820px) {
  .launch-page {
    grid-template-columns: 1fr;
    padding: 34px 0 84px;
  }
  .launch-preview {
    display: none;
  }
  .launch-countdown {
    grid-template-columns: repeat(2, 1fr);
  }
  .launch-subtitle {
    font-size: 16px;
  }
  .launch-poll-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>

<script>
(function () {
  const root = document.querySelector('[data-launch-at]');
  if (!root) return;
  const launchAt = new Date(root.getAttribute('data-launch-at')).getTime();
  const days = document.querySelector('[data-count-days]');
  const hours = document.querySelector('[data-count-hours]');
  const minutes = document.querySelector('[data-count-minutes]');
  const seconds = document.querySelector('[data-count-seconds]');
  const pad = (value) => String(value).padStart(2, '0');

  function tick() {
    const diff = Math.max(0, launchAt - Date.now());
    const totalSeconds = Math.floor(diff / 1000);
    days.textContent = pad(Math.floor(totalSeconds / 86400));
    hours.textContent = pad(Math.floor((totalSeconds % 86400) / 3600));
    minutes.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
    seconds.textContent = pad(totalSeconds % 60);
    if (diff === 0) window.location.reload();
  }
  tick();
  setInterval(tick, 1000);

  const likeButton = document.querySelector('[data-like-button]');
  const likeCount = document.querySelector('[data-like-count]');
  const likedKey = 'koloo_launch_liked_v2';
  if (localStorage.getItem(likedKey) === '1') likeButton.classList.add('is-liked');
  likeButton.addEventListener('click', function () {
    if (localStorage.getItem(likedKey) === '1') return;
    fetch('/launch-like', { method: 'POST' })
      .then(function (response) { return response.ok ? response.json() : Promise.reject(new Error('like')); })
      .then(function (payload) {
        localStorage.setItem(likedKey, '1');
        likeCount.textContent = Number(payload.likes || 0);
        likeButton.classList.add('is-liked');
      })
      .catch(function () {});
  });

  const pollKey = 'koloo_launch_poll_v2';
  const picked = localStorage.getItem(pollKey);
  if (picked) {
    const pickedButton = document.querySelector('[data-poll-choice="' + picked + '"]');
    if (pickedButton) pickedButton.classList.add('is-picked');
  }
  document.querySelectorAll('[data-poll-choice]').forEach(function (button) {
    button.addEventListener('click', function () {
      if (localStorage.getItem(pollKey)) return;
      const choice = button.getAttribute('data-poll-choice');
      fetch('/launch-vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ choice })
      })
        .then(function (response) { return response.ok ? response.json() : Promise.reject(new Error('vote')); })
        .then(function (payload) {
          const votes = payload.votes || {};
          Object.keys(votes).forEach(function (key) {
            const countEl = document.querySelector('[data-poll-count="' + key + '"]');
            if (countEl) countEl.textContent = votes[key] || 0;
          });
          localStorage.setItem(pollKey, choice);
          button.classList.add('is-picked');
        })
        .catch(function () {});
    });
  });

  const access = document.querySelector('.launch-dev-access');
  const toggle = document.querySelector('[data-dev-toggle]');
  toggle.addEventListener('click', function () {
    access.classList.toggle('is-open');
    const input = access.querySelector('input');
    if (access.classList.contains('is-open')) input.focus();
  });
  if (document.querySelector('.launch-error')) access.classList.add('is-open');
})();
</script>
</body>
</html>
